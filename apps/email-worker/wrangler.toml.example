#:schema node_modules/wrangler/config-schema.json
# ─── cmail inbound email worker — Cloudflare Workers config ───────────────
# Copy this file to `wrangler.toml` and fill in YOUR Cloudflare tenant values.
# `wrangler.toml` is gitignored so your IDs never leak to forks/clones.

name = "cmail-email-worker"
main = "src/index.ts"
workers_dev = false
preview_urls = false
routes = []
compatibility_date = "2026-08-01"
compatibility_flags = ["nodejs_compat"]

# D1 binding — must match the database_id used by the web app.
[[d1_databases]]
binding = "DB"
database_name = "cmail-db"
database_id = "YOUR_D1_DATABASE_ID"
migrations_dir = "../../packages/shared/migrations"

# R2 binding — same bucket as the web app.
[[r2_buckets]]
binding = "STORAGE"
bucket_name = "cmail-storage"

# Native, local-to-a-Cloudflare-colo inbound abuse signals. They run before D1
# but do not reject: Email Workers setReject() is permanent SMTP failure, not
# a retryable throttle. Change every namespace_id to a unique positive integer
# in your Cloudflare account, and never reuse one across environments.
[[ratelimits]]
name = "INBOUND_ACTOR_RATE_LIMITER"
namespace_id = "1001001" # placeholder: replace for your account
simple.limit = 120
simple.period = 60

[[ratelimits]]
name = "INBOUND_GLOBAL_RATE_LIMITER"
namespace_id = "1001002" # placeholder: replace for your account
simple.limit = 1000
simple.period = 60

# This third binding rate-limits the generic alert itself, not delivery.
[[ratelimits]]
name = "INBOUND_ABUSE_ALERT_RATE_LIMITER"
namespace_id = "1001003" # placeholder: replace for your account
simple.limit = 1
simple.period = 60

# Native Cloudflare Email Service sending. Pages reaches this Worker through
# the private EMAIL_SERVICE service binding; no outbound API token is required.
[[send_email]]
name = "EMAIL"

# Optional bounce and complaint feedback. Create a queue, subscribe it to each
# sending domain's Email Sending events, then uncomment this block and deploy.
# Production only: the preview Worker sends nothing, so it needs no consumer.
# See docs/deployment.md, "Bounce and complaint feedback".
# [[queues.consumers]]
# queue = "cmail-email-events"
# max_batch_size = 10
# max_batch_timeout = 5
# max_retries = 5
# dead_letter_queue = "cmail-email-events-dlq" # optional: keeps events that failed every retry

[vars]
# authserv-id of the trusted boundary MTA that stamps Authentication-Results on
# inbound mail. Inbound SPF/DKIM/DMARC verdicts are recorded only when the
# topmost record carries this identifier (RFC 8601 section 5). Leave blank and
# nothing is recorded, because an unattributed result is sender-controlled.
# Cloudflare Email Routing stamps "mx.cloudflare.net" (docs/configuration.md).
INBOUND_AUTHSERV_ID = ""
# 10 MiB default; code hard-caps this setting at 25 MiB.
MAX_INBOUND_BYTES = "10485760"
MAX_ATTACHMENTS_PER_MESSAGE = "25"
MAX_INBOUND_DECODED_BODY_BYTES = "524288"
# Atomic rolling-hour and retained-storage guardrails. Exact zero disables an
# individual guard; invalid values fall back to the documented safe default.
INBOUND_MAILBOX_MESSAGES_PER_HOUR = "120"
INBOUND_MAILBOX_BYTES_PER_HOUR = "104857600"
INBOUND_SENDER_MESSAGES_PER_HOUR = "30"
MAILBOX_STORAGE_QUOTA_BYTES = "1073741824"
# Sender limiting also requires the Worker-only INBOUND_SENDER_HASH_KEY secret.
# Generate 32 random bytes and store the unpadded base64url value with:
#   wrangler secret put INBOUND_SENDER_HASH_KEY --config apps/email-worker/wrangler.toml
# Destructive retention remains off until the operator reviews the D1
# retention_config rows and explicitly changes this value to "true".
RETENTION_JOBS_ENABLED = "false"

# Spam score at or above which inbound mail is filed to Spam instead of the
# Inbox. Higher = fewer messages quarantined; blank or non-numeric = off.
# Cloudflare Email Routing reports a score on X-CF-SpamH-Score but does not
# document its scale, so leave this blank at first: every score is still
# recorded in mail_trace regardless. Watch real traffic in Management → Mail
# trace, then set a threshold you have actually seen separate spam from
# legitimate mail. The organisation-wide sender allow/block list applies
# either way — see docs/spam-and-quarantine.md.
SPAM_QUARANTINE_SCORE = ""

# Optional PWA new-mail notifications. Match the Pages VAPID configuration.
# Store VAPID_PRIVATE_KEY with `wrangler secret put`, never in this file.
VAPID_PUBLIC_KEY = ""
VAPID_SUBJECT = ""
APP_NAME = "cmail"
PUSH_ENDPOINT_HOSTS = ""

# Optional Microsoft 365 mailbox sync (docs/m365-sync.md). Read-only toward
# Microsoft. Nothing runs until a manager turns it on in Admin >
# Microsoft 365 sync; until these are set, Admin shows "not configured".
# The client secret is a Worker secret, never a var:
#   wrangler secret put M365_CLIENT_SECRET --config apps/email-worker/wrangler.toml
# Directory (tenant) ID and application (client) ID of the read-only Entra app.
M365_TENANT_ID = ""
M365_CLIENT_ID = ""
# Optional group object IDs. Scope: only members (nested groups count) get
# accounts. Shared: members are treated as shared mailboxes. Either one
# needs the GroupMember.Read.All application permission.
M365_SCOPE_GROUP_ID = ""
M365_SHARED_GROUP_ID = ""
# Minutes between delta runs (15 to 1440). A full reconciliation runs daily.
M365_SYNC_INTERVAL_MINUTES = "60"
# Mass-pause brake: a round that would pause at least 5 people and more than
# this percent of linked people waits for a manager to approve it in Admin.
M365_SYNC_MAX_PAUSE_PERCENT = "20"
# Optional extra Exchange mailbox service plan ids (comma separated), for plans
# newer than the built-in list in docs/m365-sync.md.
M365_EXTRA_MAILBOX_PLAN_IDS = ""
# "true" also finds shared mailboxes from Exchange Online's mailbox type
# (Graph mailboxSettings userPurpose), besides M365_SHARED_GROUP_ID. Needs the
# MailboxSettings.Read application permission with admin consent, and
# migration 0026. Start in dry run.
M365_DETECT_SHARED_MAILBOXES = "false"
# Optional welcome emails to people the sync creates (docs/m365-welcome-emails.md).
# Nothing is sent until a manager turns "Welcome emails" on in Admin >
# Microsoft 365 sync. Sends through the EMAIL binding below. Most sends per
# rolling hour (1 to 500).
M365_WELCOME_MAX_PER_HOUR = "50"
# The one mail domain this deployment hosts: the same value as the web app's
# MAIL_DOMAIN. Only Microsoft 365 users whose primary address is on it sync.
MAIL_DOMAIN = ""

# Optional standby copy-back into Exchange Online (docs/copy-back.md). Uses a
# SEPARATE Entra app from the sync, whose Mail.ReadWrite is granted only
# through Exchange RBAC for Applications, scoped to a group (never consented
# tenant-wide in Entra). Nothing runs until a manager turns it on in Admin >
# Copy back to Exchange and starts a job after a dry run. Shares M365_TENANT_ID.
# The client secret is a Worker secret, never a var:
#   wrangler secret put M365_COPYBACK_CLIENT_SECRET --config apps/email-worker/wrangler.toml
M365_COPYBACK_CLIENT_ID = ""

# Optional standby test address and daily probe (docs/standby-probe.md).
# Nothing is delivered on the standby subdomain and no test runs until a
# manager turns it on in Admin > Standby test. Needs MAIL_DOMAIN above, the
# EMAIL binding (to send the test) and Email Routing on the subdomain with a
# literal rule per address (Cloudflare has no catch-all on subdomains).
# DNS label of the standby subdomain: name@standby.<MAIL_DOMAIN>.
STANDBY_SUBDOMAIN_LABEL = "standby"
# Local part of the dedicated probe system mailbox (created on first test).
STANDBY_PROBE_LOCAL_PART = "cmail-standby-probe"
# Minutes a test may take before it fails (2 to 60).
STANDBY_PROBE_TIMEOUT_MINUTES = "10"

# Optional Exchange mirror (docs/exchange-mirror.md): files the original of
# each Exchange Online journal report into every recipient's mailbox. Nothing
# is read or filed until a manager turns it on in Admin > Exchange mirror;
# with M365_JOURNAL_ADDRESS empty it is off whatever the switch says. Needs
# migration 0027, INBOUND_AUTHSERV_ID above and MAIL_DOMAIN.
# The journal address: journal-<32 to 64 random lower-case letters/digits>@<a
# domain routed to this Worker>. Keep it secret (prefer a Worker secret):
#   wrangler secret put M365_JOURNAL_ADDRESS --config apps/email-worker/wrangler.toml
# M365_JOURNAL_ADDRESS = ""
# Domains whose DKIM signature on a report is accepted, comma separated. Set
# it to exactly what refused-report diagnostics show real reports are signed
# with (typically <tenant>.onmicrosoft.com). The default, MAIL_DOMAIN, also
# matches cmail's own outgoing DKIM: replace it. DKIM proves only that the
# domain signed SOME message; the journal token is the real boundary. M365_TENANT_ID above, when set, must match the report's tenant.
M365_JOURNAL_SENDER_DOMAINS = ""
# Domain of the "undeliverable journal reports" address (JournalingReportNdrTo):
# live reports use it as their MAIL FROM. An SPF pass recorded for it plus
# this tenant's id on the report also passes. Use a dedicated domain whose SPF
# lists only include:spf.protection.outlook.com and include:_spf.mx.cloudflare.net.
# The tenant id header is attacker-settable and this relies on Exchange Online
# not letting other tenants use this MAIL FROM (unverified); the journal
# token is the real boundary. Optional.
M365_JOURNAL_NDR_DOMAIN = ""
# "false" skips the SPF/DKIM/DMARC check (weaker; see the docs). Needs
# M365_TENANT_ID, and every report must then carry that tenant id. Default "true".
M365_JOURNAL_REQUIRE_AUTH = "true"
# "true" also files the sender's copy into Sent (needs M365_TENANT_ID). Keep
# "false" until a live test shows originals carry the tenant headers.
M365_JOURNAL_MIRROR_SENT = "false"
# Reports larger than MAX_INBOUND_BYTES + 1 MiB are refused unread.
# Subrequests one report may use for filing (about 4 + attachments per copy).
# Raise [limits] subrequests first if you raise this above 10,000.
M365_JOURNAL_SUBREQUEST_BUDGET = "8000"

[triggers]
# 17 3 * * *: retention (off unless RETENTION_JOBS_ENABLED).
# 7 * * * *: refresh the local phishing-domain list for link checks (hourly).
# */15 * * * *: Microsoft 365 sync and standby copy-back (each returns at once
# unless switched on in Admin).
# */10 * * * *: standby probe (returns at once unless switched on in Admin).
crons = ["17 3 * * *", "7 * * * *", "*/15 * * * *", "*/10 * * * *"]

# Email Routing — configure a catch-all in the Cloudflare dashboard
# pointing all inbound mail at this worker.

# Isolated, non-sending target for Pages preview deployments. It deliberately
# has no native send_email binding. Configure preview Email Routing only when
# using a separate test domain; never route production mail here.
[env.preview]
name = "cmail-email-worker-preview"
workers_dev = false
preview_urls = false
routes = []
send_email = []

[[env.preview.d1_databases]]
binding = "DB"
database_name = "cmail-db-preview"
database_id = "YOUR_PREVIEW_D1_DATABASE_ID"
migrations_dir = "../../packages/shared/migrations"

[[env.preview.r2_buckets]]
binding = "STORAGE"
bucket_name = "cmail-storage-preview"

# Preview deliberately has independent limiter namespaces: otherwise preview
# traffic could consume production counters (or the reverse).
[[env.preview.ratelimits]]
name = "INBOUND_ACTOR_RATE_LIMITER"
namespace_id = "1001004" # placeholder: replace for your account
simple.limit = 120
simple.period = 60

[[env.preview.ratelimits]]
name = "INBOUND_GLOBAL_RATE_LIMITER"
namespace_id = "1001005" # placeholder: replace for your account
simple.limit = 1000
simple.period = 60

[[env.preview.ratelimits]]
name = "INBOUND_ABUSE_ALERT_RATE_LIMITER"
namespace_id = "1001006" # placeholder: replace for your account
simple.limit = 1
simple.period = 60

[env.preview.vars]
MAX_INBOUND_BYTES = "10485760"
MAX_INBOUND_DECODED_BODY_BYTES = "524288"
MAX_ATTACHMENTS_PER_MESSAGE = "25"
INBOUND_MAILBOX_MESSAGES_PER_HOUR = "120"
INBOUND_MAILBOX_BYTES_PER_HOUR = "104857600"
INBOUND_SENDER_MESSAGES_PER_HOUR = "30"
MAILBOX_STORAGE_QUOTA_BYTES = "1073741824"
VAPID_PUBLIC_KEY = ""
VAPID_SUBJECT = ""
APP_NAME = "cmail preview"
PUSH_ENDPOINT_HOSTS = ""
RETENTION_JOBS_ENABLED = "false"
